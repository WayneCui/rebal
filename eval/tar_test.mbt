///|
test "tar decode lists members and can keep one file" {
  // codecs-test.r3 "Decode TAR using the codec directly".
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "bin: #{} full: decode 'tar bin only: decode/only 'tar bin %test.txt (reduce [(length? full) = 8 (reduce [full/1 full/3 full/5 full/7]) = [%test.txt %dir/ %dir/inside/ %dir/make.r3] (pick full/2 1) = #{7465737474657374} (mold pick full/2 2) = {[\"test.txt\" \"0100777\" 0 0 8 1542188722 3938 48 \"\"]} (mold pick full/2 3) = {[\"ustar\" \"00\" \"\" \"\" \"\" \"\" \"\"]} (length? only) = 2 (only/1) = %test.txt (only/2/1) = #{7465737474657374}]) = reduce [true true true true true true true true]",
    )
    is @value.Logic(true),
  )
}
