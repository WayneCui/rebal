///|
test "provision decode unwraps the signed property list" {
  // codecs-test.r3 "Load mobileprovision file".
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "data: decode 'provision #{} (reduce [(type? data) = map! (data/AppIDName) = \"Samorost 1\" (data/UUID) = \"be387546-d90d-40cd-83e6-95eb6f5f0861\" (type? data/ProvisionedDevices) = block! (type? data/DeveloperCertificates) = block! (type? decode 'crt pick data/DeveloperCertificates 1) = object! (decode 'provision #{00}) = none]) = reduce [true true true true true true true]",
    )
    is @value.Logic(true),
  )
}
