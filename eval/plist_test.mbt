///|
test "plist decode reads dicts, dates, and base64 data" {
  // codecs-test.r3 "Load PLIST file (XML version)".
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "data: decode 'plist {<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\">\n<dict>\n\t<key>AppIDName</key>\n\t<string>Test Application</string>\n\t<key>ApplicationIdentifierPrefix</key>\n\t<array>\n\t<string>XXXXXXXXXX</string>\n\t</array>\n\t<key>CreationDate</key>\n\t<date>2022-03-25T11:00:04Z</date>\n\t<key>Platform</key>\n\t<array>\n\t\t\t<string>OSX</string>\n\t</array>\n\t<key>IsXcodeManaged</key>\n\t<true/>\n\t<key>DeveloperCertificates</key>\n\t<array>\n\t\t<data>UGxhY2Vob2xkZXI=</data>\n\t\t<data>Q2VydGlmaWNhdGU=</data>\n\t</array>\n\n\t<key>DER-Encoded-Profile</key>\n\t<data>UGxhY2Vob2xkZXI=</data>\n\t\t\t\t\t\t\t\t\t\t\t\t\n\t<key>Entitlements</key>\n\t<dict>\n\t\t\t\t\n\t\t\t\t<key>com.apple.developer.arcade-operations</key>\n\t\t<true/>\n\t\t\t\t\n\t\t\t\t<key>com.apple.application-identifier</key>\n\t\t<string>XXXXXXXXXX.application.test</string>\n\t\t\t\t\n\t\t\t\t<key>keychain-access-groups</key>\n\t\t<array>\n\t\t\t\t<string>XXXXXXXXXX.*</string>\n\t\t</array>\n\t\t\t\t\n\t\t\t\t<key>com.apple.developer.team-identifier</key>\n\t\t<string>XXXXXXXXXX</string>\n\t\t\t\t\n\t\t\t\t<key>com.apple.developer.ubiquity-kvstore-identifier</key>\n\t\t<string>XXXXXXXXXX.*</string>\n\t\t\t\t\n\t\t\t\t<key>com.apple.developer.ubiquity-container-identifiers</key>\n\t\t<array>\n\t\t\t\t<string>XXXXXXXXXX.*</string>\n\t\t</array>\n\n\t</dict>\n\t<key>ExpirationDate</key>\n\t<date>2023-03-25T11:00:04Z</date>\n\t<key>Name</key>\n\t<string>Mac Team Provisioning Profile: application.test</string>\n\t<key>ProvisionedDevices</key>\n\t<array>\n\t\t<string>DA3279C7-4CA2-5F13-AD90-7FC271175118</string>\n\t\t<string>94FAF6E4-BE34-5B0B-9533-78B245EF4174</string>\n\t</array>\n\t<key>TeamIdentifier</key>\n\t<array>\n\t\t<string>XXXXXXXXXX</string>\n\t</array>\n\t<key>TeamName</key>\n\t<string>Some Company s.r.o.</string>\n\t<key>TimeToLive</key>\n\t<integer>365</integer>\n\t<key>UUID</key>\n\t<string>bba91992-3a72-46b3-bc5f-f7b59aa49236</string>\n\t<key>Version</key>\n\t<integer>1</integer>\n</dict>\n</plist>} (reduce [(type? data) = map! (data/AppIDName) = \"Test Application\" (data/UUID) = \"bba91992-3a72-46b3-bc5f-f7b59aa49236\" (data/CreationDate) = 25-Mar-2022/11:00:04 (data/TimeToLive) = 365 (data/Version) = 1 (data/IsXcodeManaged) = true (length? data/ProvisionedDevices) = 2 (data/Entitlements/com.apple.application-identifier) = \"XXXXXXXXXX.application.test\" (pick data/DeveloperCertificates 1) = #{506C616365686F6C646572} (decode 'plist {hello}) = none]) = reduce [true true true true true true true true true true true]",
    )
    is @value.Logic(true),
  )
}
