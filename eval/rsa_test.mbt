///|
test "rsa-init stores a public or private handle" {
  // rsa-test.r3 "Init RSA keys", with a 512-bit key.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "((reduce [mold rsa-init #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} #{010001} mold rsa-init/private #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} #{010001} #{B4E6B9713F17D630E1AA38C90027C4E0CC093CB8E5A9FDB14814DDB777B015252720006E7305669204B62B4172522524B55248F736094297479C114DE52BEBE1} #{FDDE07331BB719B8F9EABE6AB8EB8A53B432F3A080CA61D2D343F00E4AA71759} #{ED85157EC471E3601421BAC1462A674C9ADF4D74C4E68E03B3B8A40F05E9F727} query rsa-init/private #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} #{010001} #{B4E6B9713F17D630E1AA38C90027C4E0CC093CB8E5A9FDB14814DDB777B015252720006E7305669204B62B4172522524B55248F736094297479C114DE52BEBE1} #{FDDE07331BB719B8F9EABE6AB8EB8A53B432F3A080CA61D2D343F00E4AA71759} #{ED85157EC471E3601421BAC1462A674C9ADF4D74C4E68E03B3B8A40F05E9F727} 'type none? rsa-init #{05} #{03}]) = reduce [{#(handle! rsa)} {#(handle! rsa)} 'rsa true])",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa sign and verify use pkcs1 and sha256" {
  // rsa-test.r3 "RSA signing" and "RSA verification". The signature matches OpenSSL.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} e: #{010001} d: #{B4E6B9713F17D630E1AA38C90027C4E0CC093CB8E5A9FDB14814DDB777B015252720006E7305669204B62B4172522524B55248F736094297479C114DE52BEBE1} p: #{FDDE07331BB719B8F9EABE6AB8EB8A53B432F3A080CA61D2D343F00E4AA71759} q: #{ED85157EC471E3601421BAC1462A674C9ADF4D74C4E68E03B3B8A40F05E9F727} pri: rsa-init/private n e d p q pub: rsa-init n e sig: rsa/sign pri #{41686F6A21} (reduce [sig none? rsa/sign pub #{41686F6A21} rsa/verify pub #{41686F6A21} sig rsa/verify pri #{41686F6A21} sig rsa/verify pub #{41686F6A21} #{00}]) = reduce [#{19EC225FCE58972FABCE7F741D22A34946A401F903C6D2E4E91781806132CDE40411DA73E53CDE7ACE6C9325DE658BB9E820CF4D9CE50997A92DF27FF0B8A82D} true true true false]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa encrypt and decrypt round trip with pkcs1 padding" {
  // rsa-test.r3 "RSA encrypt" and "RSA decrypt". Padding bytes come from the system generator.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} e: #{010001} d: #{B4E6B9713F17D630E1AA38C90027C4E0CC093CB8E5A9FDB14814DDB777B015252720006E7305669204B62B4172522524B55248F736094297479C114DE52BEBE1} p: #{FDDE07331BB719B8F9EABE6AB8EB8A53B432F3A080CA61D2D343F00E4AA71759} q: #{ED85157EC471E3601421BAC1462A674C9ADF4D74C4E68E03B3B8A40F05E9F727} pri: rsa-init/private n e d p q pub: rsa-init n e msg: #{41686F6A21} secret: rsa/encrypt pub msg other: rsa/encrypt pri msg (reduce [rsa/decrypt pri secret none? rsa/decrypt pub secret rsa/decrypt pri other secret <> other none? rsa/encrypt pub #{111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111}]) = reduce [msg true msg true true]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa hash refinement selects the digest inside the signature" {
  // rsa/sign/hash defaults aside, SHA-1 matches OpenSSL and SHA-512 does not fit this key.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} e: #{010001} d: #{B4E6B9713F17D630E1AA38C90027C4E0CC093CB8E5A9FDB14814DDB777B015252720006E7305669204B62B4172522524B55248F736094297479C114DE52BEBE1} p: #{FDDE07331BB719B8F9EABE6AB8EB8A53B432F3A080CA61D2D343F00E4AA71759} q: #{ED85157EC471E3601421BAC1462A674C9ADF4D74C4E68E03B3B8A40F05E9F727} pri: rsa-init/private n e d p q pub: rsa-init n e sig: rsa/sign/hash pri #{41686F6A21} 'sha1 (reduce [sig rsa/verify/hash pub #{41686F6A21} sig 'sha1 rsa/verify/hash pri #{41686F6A21} sig 'sha256 none? rsa/sign/hash pri #{41686F6A21} 'sha512 none? rsa/verify/hash pub #{41686F6A21} sig 'crc32]) = reduce [#{3C25A2791E92DFF113F38173D89325BF86294897AC1F6570E281C414EB9C876B7ED315863292FEAECE6F5952FD527BFE7819B155DDF378531ACBBFED76E781E8} true false true true]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa oaep decrypts an openssl ciphertext and its own" {
  // rsa-test.r3 "RSA-OAEP encrypt" and "RSA-OAEP decrypt".
  // The fixed ciphertext is OpenSSL RSAES-OAEP with SHA-256 and an empty label.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{BA11A0EAA55A45C8FFB255B56CC1E2BFE516C50DE4DCBA4237D255C0D0D889312567CED29962924B64115B95E18A5F109F6592D1A35CE3FFC5447751BD3AED822AC83B2A584B6976CB31A13079476DAFB5B02D6A55999457DC457FFA7AFEC4837EC523824E77F1D7CDC30D60A205C3322180B1699B41FCCB5E6E4A3F1B212967} e: #{010001} d: #{AF36FE8337A66464BC7420C5B15E7ABA1D6E6DAD81C0611D0E17E16CAABDDDA30C084EF87E3C166B2C16345A5582C9B68B8348D864AF8A7C46350CEF49F47DC621E7DA51E8B4202F14F588D6E46DC6F767D84E4155CA1D3FA9C97407676AB67FB32819290E3837F436BB1E2A356F358126FE791D1CD2650B5382CE58304D9F41} p: #{F4C06B12745DCCDE5458DEB5267D4E428ADF8736D9D08535D9100DD1A2509D3A242E1C92A2766B0CD39504C902F10CBA351C69895EF8F4811DE8C9D4083E7AD7} q: #{C29EC9E37EA79862624D6C704CF45646E274A25844F0CB53ED62810C4490BA09E7A962B49AC4E9ACD356D2AB3C50C1FB75B0772EEF4E3E37A63BE7CB753903F1} pri: rsa-init/private n e d p q pub: rsa-init n e msg: #{41686F6A21} secret: rsa/encrypt/oaep pub msg (reduce [rsa/decrypt/oaep pri #{7AE0E275345FCA02310460F3927FE5E75B0B1570F526642396B0D613C0C87DA6488390956E4254BC4B04639A9B47EF8E42AE4248A7349DFB05BB9122D2DA71F04373F99B083A71D7B778ECCB49BFB7C435E7BE3D270BE1F7D937BBA791C45E55E8E8F3AE9A629ADD7E718341A94DF9076926F1D82193353701454A89310635A0} rsa/decrypt/oaep pri secret none? rsa/decrypt/oaep pub secret secret <> rsa/encrypt/oaep pub msg none? rsa/encrypt/oaep pub #{111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111}]) = reduce [msg msg true true true]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa pss verifies an openssl signature and its own" {
  // rsa-test.r3 "RSA-PSS signing" and "RSA-PSS verification".
  // The fixed signature is OpenSSL RSASSA-PSS with SHA-256 and a digest-length salt.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{BA11A0EAA55A45C8FFB255B56CC1E2BFE516C50DE4DCBA4237D255C0D0D889312567CED29962924B64115B95E18A5F109F6592D1A35CE3FFC5447751BD3AED822AC83B2A584B6976CB31A13079476DAFB5B02D6A55999457DC457FFA7AFEC4837EC523824E77F1D7CDC30D60A205C3322180B1699B41FCCB5E6E4A3F1B212967} e: #{010001} d: #{AF36FE8337A66464BC7420C5B15E7ABA1D6E6DAD81C0611D0E17E16CAABDDDA30C084EF87E3C166B2C16345A5582C9B68B8348D864AF8A7C46350CEF49F47DC621E7DA51E8B4202F14F588D6E46DC6F767D84E4155CA1D3FA9C97407676AB67FB32819290E3837F436BB1E2A356F358126FE791D1CD2650B5382CE58304D9F41} p: #{F4C06B12745DCCDE5458DEB5267D4E428ADF8736D9D08535D9100DD1A2509D3A242E1C92A2766B0CD39504C902F10CBA351C69895EF8F4811DE8C9D4083E7AD7} q: #{C29EC9E37EA79862624D6C704CF45646E274A25844F0CB53ED62810C4490BA09E7A962B49AC4E9ACD356D2AB3C50C1FB75B0772EEF4E3E37A63BE7CB753903F1} pri: rsa-init/private n e d p q pub: rsa-init n e msg: #{41686F6A21} fixed: #{10351319FD5FD1506CF08080659D57E4B4E9C5B600D572F4F4BDE9D740E643409D33379386411859176327D4B59DE67239F006727DAF0847CD7ED20914D6EE1E9D6A348D1B1011E0E8AFBC43352B8DA230293A9D255955D40B07A0E60B5349609CA1A979F4C2B059C9634C3ED020FFBFA721CAB9E4E5C55F118DF4CB434F67BB} fresh: rsa/sign/pss pri msg (reduce [(rsa/verify/pss pub msg fixed) = true (rsa/verify/pss pri msg fixed) = true (rsa/verify/pss pub msg fresh) = true none? rsa/sign/pss pub msg fresh <> (rsa/sign/pss pri msg) (not rsa/verify/pss pub msg #{00}) none? rsa/sign/hash/pss pri msg 'sha512]) = reduce [true true true true true true true]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa hash sha512 signs the rebol api server certificate" {
  // rsa-test.r3 "RSA sign/verify using external file".
  // The signature is OpenSSL PKCS#1 v1.5 with SHA-512 over apiserver.crt.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{} e: #{25} d: #{} p: #{00FD80C6C95E6CB9A16D52CD162913615514AF79E146C55B0BF5744DE9B42C6E167A35580DD8DE64562467987B3CCDFA3D57CCA734AC499307865D640A046D8096313277474CF11C5316809859DBB7F7CACD1098F503B4D6D93BF491B2CF72686E26A22F9442BF11951F3CDACBC05E72E02C3C3A9325552E26EA3D20F4D8A2D2B5} q: #{00F4CC306E3DCB025170DFBB618284FBBB5F7B7CE4868ACAC14407513102C40953CACAD0B8B0E4988840F6375D934540BD02CD339E0F766B98C4D3713D7400BFBDAA0A25506EB3F84ACA10E8BFF749424BF30CD005C001177E499FF998C7E5576113CC28D9CF3AF27FAC471DC71922DA3820F15C4BC262701214E4A202CCE56C4B} pri: rsa-init/private n e d p q pub: rsa-init n e data: #{} sig: rsa/sign/hash pri data 'sha512 (reduce [sig (rsa/verify/hash pub data sig 'sha512) = true (rsa/verify/hash pri data sig 'sha512) = true]) = reduce [#{} true true]",
    )
    is @value.Logic(true),
  )
}

///|
test "release makes an rsa handle unusable" {
  // rsa-test.r3 "RSA key release". A copy shares the freed handle.
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "n: #{EB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} e: #{010001} key: rsa-init n e copy: key (reduce [release key release 1 (type? try [rsa/encrypt key #{41686F6A21}]) (type? try [query copy 'type])]) = reduce [true false error! error!]",
    )
    is @value.Logic(true),
  )
}

///|
test "rsa reads a modulus and a signature that are not at the head" {
  // rsa-test.r3 "Test input which isn't exactly at its head".
  let env = @eval.Env::new()
  assert_true(
    @eval.run(
      env, "mod: #{0BADCAFEEB8A8654FAE3935DBC163A6C9F37839E799B66FB86B920C7E3CB2CEE80446BE60772924403C2F3640A2228F3FF4448F52569611A2655479AEE25F3F493FC6D8F} key: rsa-init at mod 5 next #{FF010001} msg: #{41686F6A21} sig: #{19EC225FCE58972FABCE7F741D22A34946A401F903C6D2E4E91781806132CDE40411DA73E53CDE7ACE6C9325DE658BB9E820CF4D9CE50997A92DF27FF0B8A82D} ok: rsa/verify key msg sig msg: insert msg #{0BADCAFE} sig: insert sig #{0BADCAFE} (reduce [ok rsa/verify key msg sig]) = reduce [true true]",
    )
    is @value.Logic(true),
  )
}
