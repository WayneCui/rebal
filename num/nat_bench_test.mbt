///|
test "a 2048-bit power with a 256-bit exponent matches" {
  let got = @num.Nat::mod_exp(
    @num.Nat::from_bytes(
      hex_bytes(
        "",
      ),
    ),
    @num.Nat::from_bytes(
      hex_bytes(
        "345dd2a3a0591effcc152a1bb891f6f764cd8293d0c9ceeffc85da0be801a6e7",
      ),
    ),
    @num.Nat::from_bytes(
      hex_bytes(
        "",
      ),
    ),
  )
  assert_eq(
    got.be_bytes(256),
    hex_bytes(
      "",
    ),
  )
}
